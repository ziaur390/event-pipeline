{
  "title": "Event Pipeline",
  "uid": "event-pipeline",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Events stored (total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "pipeline_events_stored" }]
    },
    {
      "id": 2,
      "title": "Queue depth (is the consumer keeping up?)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "targets": [{ "expr": "pipeline_queue_depth" }]
    },
    {
      "id": 3,
      "title": "DLQ depth (correctness — alert on this)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [{ "expr": "pipeline_dlq_depth" }],
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-GrYlRd" } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Dead letters recorded (database)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 },
      "targets": [{ "expr": "pipeline_dead_letter_rows" }]
    },
    {
      "id": 5,
      "title": "Throughput vs backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "expr": "pipeline_events_stored" },
        { "expr": "pipeline_queue_depth" }
      ]
    }
  ]
}
